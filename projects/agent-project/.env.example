# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，绝不要提交

# ---------- 生成层：本地 / 云端双模式 ----------
LLM_BACKEND=local

# local 模式（推荐：零成本、数据不出内网）
# 方案 A：Unsloth Studio 自带的 llama-server
LOCAL_BASE_URL=http://127.0.0.1:53967/v1
LOCAL_KEY=omlx-你的key或unsloth的key
LOCAL_MODEL=unsloth/Qwen3.5-4B-GGUF
# 方案 B：oMLX（模型名 = ~/.omlx/models 下的目录名）
# LOCAL_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_MODEL=Qwen2.5-0.5B

# api 模式：只有 LLM_BACKEND=api 时才需要
# DEEPSEEK_API_KEY=sk-xxx

# 测试护栏触发时设 1
# TEST_GUARDRAIL=1